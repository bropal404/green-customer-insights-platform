{
  "file": "product_labels.csv",
  "primary_key": [
    "customer_id",
    "product_id"
  ],
  "schema_version": "2.0",
  "columns": {
    "customer_id": {
      "type": "string",
      "description": "FK to customers.customer_id",
      "pattern": "^C[0-9]{5}$",
      "references": "customers.csv.customer_id",
      "required": true
    },
    "product_id": {
      "type": "string",
      "description": "Product code",
      "enum": [
        "GP01",
        "GP02",
        "GP03",
        "GP04"
      ],
      "required": true
    },
    "product_name": {
      "type": "string",
      "description": "GP01 EV Finance, GP02 Green Home Loan, GP03 Solar Finance, GP04 Paperless Banking",
      "enum": [
        "EV Finance",
        "Green Home Loan",
        "Solar Finance",
        "Paperless Banking"
      ],
      "required": true
    },
    "eligible_for_recommendation": {
      "type": "boolean",
      "description": "Rule-based business eligibility; independent of propensity",
      "required": true
    },
    "ineligibility_reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "Code when not eligible, else null",
      "enum": [
        "ALREADY_BEV",
        "SOLAR_ALREADY_INSTALLED",
        "NOT_HOME_OWNER",
        "ALREADY_DIGITAL",
        "NO_DATA",
        null
      ],
      "required": true
    },
    "propensity_label": {
      "type": "number",
      "description": "Synthetic latent propensity 0-1; not eligibility, not a real probability",
      "minimum": 0,
      "maximum": 1,
      "required": true
    },
    "simulated_takeup": {
      "type": "integer",
      "description": "Synthetic outcome drawn from propensity (Bernoulli); 0 if not eligible",
      "enum": [
        0,
        1
      ],
      "required": true
    },
    "reason_codes": {
      "type": "string",
      "description": "Pipe-separated fixed codes, e.g. HIGH_FUEL_SPEND|PETROL_VEHICLE|HIGH_ANNUAL_MILEAGE",
      "required": true
    },
    "label_version": {
      "type": "string",
      "description": "Version of the label-generation rules, e.g. v1.0",
      "required": true
    },
    "data_as_of": {
      "type": "string",
      "description": "Date labels were generated against",
      "format": "date",
      "required": true
    }
  }
}