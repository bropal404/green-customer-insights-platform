{
  "file": "customers.csv",
  "primary_key": "customer_id",
  "schema_version": "2.0",
  "columns": {
    "customer_id": {
      "type": "string",
      "description": "Primary key, e.g. C00001",
      "pattern": "^C[0-9]{5}$",
      "required": true
    },
    "age": {
      "type": "integer",
      "description": "Age in years",
      "minimum": 18,
      "maximum": 100,
      "required": true
    },
    "income_annual_estimated": {
      "type": "number",
      "description": "Estimated annual gross income, GBP",
      "minimum": 0,
      "required": true
    },
    "region": {
      "type": "string",
      "description": "UK region",
      "enum": [
        "North East",
        "North West",
        "Yorkshire and The Humber",
        "East Midlands",
        "West Midlands",
        "East of England",
        "London",
        "South East",
        "South West",
        "Wales",
        "Scotland",
        "Northern Ireland"
      ],
      "required": true
    },
    "tenure_months": {
      "type": "integer",
      "description": "Months banking with the institution",
      "minimum": 0,
      "required": true
    },
    "paper_statement_opt_in": {
      "type": "boolean",
      "description": "True = paper statements; False = fully digital",
      "required": true
    },
    "has_current_account": {
      "type": "boolean",
      "description": "Always true in this dataset",
      "const": true,
      "required": true
    },
    "has_mortgage": {
      "type": "boolean",
      "description": "True if actively paying a mortgage",
      "required": true
    },
    "has_auto_loan": {
      "type": "boolean",
      "description": "True if actively paying an auto finance loan",
      "required": true
    },
    "has_investment_account": {
      "type": "boolean",
      "description": "True if holding investment products (optional Green Investments use case)",
      "required": true
    },
    "home_ownership_status": {
      "type": "string",
      "description": "Home ownership",
      "enum": [
        "OWNER_OUTRIGHT",
        "OWNER_MORTGAGED",
        "RENTER"
      ],
      "required": true
    },
    "property_type": {
      "type": [
        "string",
        "null"
      ],
      "description": "Property type; null only if unknown",
      "enum": [
        "DETACHED",
        "SEMI_DETACHED",
        "TERRACED",
        "FLAT_APARTMENT",
        null
      ],
      "required": true
    },
    "epc_rating": {
      "type": [
        "string",
        "null"
      ],
      "description": "EPC energy rating A (best) to G; null if unknown",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G",
        null
      ],
      "required": true
    },
    "solar_installed": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "True if solar PV already installed (blocks GP03). Null = unknown",
      "required": true
    },
    "current_vehicle_type": {
      "type": "string",
      "description": "Primary vehicle",
      "enum": [
        "PETROL",
        "DIESEL",
        "HYBRID",
        "BEV",
        "NONE"
      ],
      "required": true
    },
    "estimated_annual_mileage": {
      "type": "integer",
      "description": "Estimated miles/year; 0 when vehicle type is NONE",
      "minimum": 0,
      "required": true
    },
    "auto_loan_months_remaining": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Months remaining on active auto loan; null if no loan. (Replaces misnamed existing_auto_finance_end_date)",
      "minimum": 0,
      "required": true
    },
    "current_account_balance": {
      "type": "number",
      "description": "Current account balance, GBP",
      "minimum": 0,
      "required": true
    },
    "investment_account_balance": {
      "type": [
        "number",
        "null"
      ],
      "description": "Investment balance, GBP; null if no investment account",
      "minimum": 0,
      "required": true
    },
    "mortgage_balance_remaining": {
      "type": [
        "number",
        "null"
      ],
      "description": "Outstanding mortgage principal, GBP; null if no mortgage",
      "minimum": 0,
      "required": true
    },
    "auto_loan_balance_remaining": {
      "type": [
        "number",
        "null"
      ],
      "description": "Outstanding auto-loan principal, GBP; null if no auto loan",
      "minimum": 0,
      "required": true
    },
    "mobile_app_logins_monthly": {
      "type": "integer",
      "description": "Monthly mobile app logins",
      "minimum": 0,
      "required": true
    },
    "web_portal_logins_monthly": {
      "type": "integer",
      "description": "Monthly web portal logins",
      "minimum": 0,
      "required": true
    },
    "avg_monthly_fuel_spend": {
      "type": "number",
      "description": "Avg monthly spend at petrol stations, GBP",
      "minimum": 0,
      "required": true
    },
    "avg_monthly_electricity_spend": {
      "type": "number",
      "description": "Avg monthly electricity bill, GBP",
      "minimum": 0,
      "required": true
    },
    "avg_monthly_gas_spend": {
      "type": "number",
      "description": "Avg monthly gas bill, GBP",
      "minimum": 0,
      "required": true
    },
    "avg_monthly_public_transport_spend": {
      "type": "number",
      "description": "Avg monthly spend on rail, bus, TfL, GBP",
      "minimum": 0,
      "required": true
    },
    "avg_monthly_home_improvement_spend": {
      "type": "number",
      "description": "Avg monthly spend at B&Q, Wickes etc., GBP",
      "minimum": 0,
      "required": true
    },
    "avg_monthly_automotive_spend": {
      "type": "number",
      "description": "Avg monthly spend on mechanics/tyres/servicing, GBP",
      "minimum": 0,
      "required": true
    },
    "heating_type": {
      "type": "string",
      "description": "Main heating (carbon engine for Green Home Loan)",
      "enum": [
        "GAS_BOILER",
        "ELECTRIC",
        "OIL",
        "HEAT_PUMP",
        "OTHER"
      ],
      "required": true
    },
    "floor_area_sqm": {
      "type": [
        "number",
        "null"
      ],
      "description": "Approx. floor area, m2 (home-retrofit impact baseline); null if unknown",
      "minimum": 10,
      "required": true
    },
    "has_off_street_parking": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Can charge an EV at home (EV Finance signal); null if unknown",
      "required": true
    },
    "vehicle_age_years": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Age of current vehicle; null if vehicle type NONE",
      "minimum": 0,
      "required": true
    },
    "statements_per_year": {
      "type": "integer",
      "description": "Paper statements mailed per year (Paperless impact baseline); 0 if digital",
      "minimum": 0,
      "maximum": 24,
      "required": true
    },
    "sustainability_preference_flag": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Opted into/declared interest in green products (optional Green Investments); null if never asked",
      "required": true
    },
    "data_as_of": {
      "type": "string",
      "description": "Snapshot date of this record, ISO 8601 date (FR7 data timestamp)",
      "format": "date",
      "required": true
    },
    "split": {
      "type": "string",
      "description": "Customer-level split; every row of a customer in other tables inherits it (no leakage)",
      "enum": [
        "train",
        "validation",
        "test"
      ],
      "required": true
    }
  }
}